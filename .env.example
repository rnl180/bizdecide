# Firebase Admin (local dev only). On Firebase App Hosting, credentials are automatic.
# Paste the service account JSON, base64-encoded:  base64 -w0 service-account.json
FIREBASE_SERVICE_ACCOUNT_BASE64=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app

# Claude API key (console.anthropic.com > API keys). When set, Claude Opus 5.5 runs the analysis and
# answers "Ask your CFO" on the server; leave it empty to have WorkBuddy do it through /api/mcp.
ANTHROPIC_API_KEY=

# Stage fallback: 1 replays the recorded demo run (docs/demo-run.fixture.json) for the demo café, no API key needed.
# Owner questions still open live (audience poll). Record a new run with: node scripts/capture-demo-run.mjs
BIZDECIDE_REPLAY=
# Optional: replay faster than recorded (2 = twice as fast). Gaps are capped at 25 s either way.
BIZDECIDE_REPLAY_SPEED=

# Shared secret WorkBuddy sends to the MCP server:  Authorization: Bearer <value>
# Generate one:  openssl rand -hex 32
BIZDECIDE_MCP_KEY=
